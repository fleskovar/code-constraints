    <packagedElement xmi:type="uml:Activity" xmi:id="activity-f19b7c71d93475e4" name="book_availability" cdec:granularity="statement" cdec:status="unchanged" cdec:file="catalog/book.py" cdec:startLine="20" cdec:endLine="25">
      <node xmi:type="uml:InitialNode" xmi:id="init1" cdec:status="unchanged"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="a2" name="in_stock = self.stock &gt;= requested" cdec:status="unchanged"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="a3" name="priced = self.price &gt; 0" cdec:status="unchanged"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="a4" name="result = in_stock and priced" cdec:status="unchanged"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="a5" name="return result" cdec:status="unchanged"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="final6" cdec:status="unchanged"/>
      <edge xmi:type="uml:ControlFlow" source="init1" target="a2" cdec:status="unchanged"/>
