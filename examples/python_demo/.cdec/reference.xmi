        <ownedComment xmi:type="uml:Comment" xmi:id="comment-7171b22f81535bb8">
          <body>A finalised receipt: built once, never mutated, never subclassed.</body>
        </ownedComment>
        <cdec:rule name="immutable"/>
        <cdec:rule name="sealed"/>
        <cdec:rule name="layer">
          <cdec:arg value="'orders'"/>
        </cdec:rule>
        <ownedAttribute xmi:type="uml:Property" name="total" visibility="public" cdec:type="float" cdec:status="unchanged"/>
        <ownedAttribute xmi:type="uml:Property" name="lines" visibility="public" cdec:type="int" cdec:status="unchanged"/>
        <ownedOperation xmi:type="uml:Operation" name="__init__" visibility="protected" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="total" direction="in" cdec:type="float"/>
          <ownedParameter xmi:type="uml:Parameter" name="lines" direction="in" cdec:type="int"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="None"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" name="formatted" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="str"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class-9312dcf0adef004d" name="AuditEntry" cdec:qualifiedName="orders.AuditEntry" cdec:kind="class" cdec:status="unchanged" cdec:file="orders/billing.py" cdec:startLine="45" cdec:endLine="51">
        <ownedComment xmi:type="uml:Comment" xmi:id="comment-68cc412a2bbc66c8">
          <body>A lightweight bookkeeping record. It is *not* factory-controlled, so
services may build it directly — which is why `CheckoutService` lists it in
its ``allow``.</body>
        </ownedComment>
        <cdec:rule name="layer">
          <cdec:arg value="'orders'"/>
        </cdec:rule>
        <ownedAttribute xmi:type="uml:Property" name="action" visibility="public" cdec:type="str" cdec:status="unchanged"/>
        <ownedOperation xmi:type="uml:Operation" name="__init__" visibility="protected" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="action" direction="in" cdec:type="str"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="None"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class-93950a9f8f772439" name="ReceiptFactory" cdec:qualifiedName="orders.ReceiptFactory" cdec:kind="class" cdec:status="unchanged" cdec:file="orders/billing.py" cdec:startLine="56" cdec:endLine="61">
        <ownedComment xmi:type="uml:Comment" xmi:id="comment-68e72c480ee2c291">
          <body>The designated constructor of `Receipt`. Building a `Receipt` anywhere
else is a ``factory`` violation.</body>
        </ownedComment>
        <cdec:rule name="factory">
          <cdec:kwarg key="creates" value="['Receipt']"/>
        </cdec:rule>
        <cdec:rule name="layer">
          <cdec:arg value="'orders'"/>
        </cdec:rule>
        <ownedOperation xmi:type="uml:Operation" name="for_cart" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="cart" direction="in" cdec:type="Cart"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="Receipt"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class-852b253a735df78b" name="CheckoutService" cdec:qualifiedName="orders.CheckoutService" cdec:kind="class" cdec:status="unchanged" cdec:file="orders/billing.py" cdec:startLine="66" cdec:endLine="88">
        <ownedComment xmi:type="uml:Comment" xmi:id="comment-8ba8963f182a3ce9">
          <body>Coordinates an existing cart and the receipt factory.

Tagged ``@no_instantiation`` because a service should orchestrate, not
construct: it delegates `Receipt` creation to `ReceiptFactory`.
``allow=["AuditEntry"]`` carves out the one bookkeeping type it may still
build directly.</body>
        </ownedComment>
        <cdec:rule name="no-instantiation">
          <cdec:kwarg key="allow" value="['AuditEntry']"/>
        </cdec:rule>
        <cdec:rule name="layer">
          <cdec:arg value="'orders'"/>
        </cdec:rule>
        <ownedAttribute xmi:type="uml:Property" name="receipts" visibility="public" cdec:type="ReceiptFactory" cdec:status="unchanged"/>
        <ownedOperation xmi:type="uml:Operation" name="__init__" visibility="protected" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="receipts" direction="in" cdec:type="ReceiptFactory"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="None"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" name="summarize" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="cart" direction="in" cdec:type="Cart"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="dict"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" name="quick_receipt" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="cart" direction="in" cdec:type="Cart"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="Receipt"/>
        </ownedOperation>
      </packagedElement>
