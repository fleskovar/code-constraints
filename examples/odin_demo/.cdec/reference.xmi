        <cdec:dependency type="Receipt"/>
        <ownedAttribute xmi:type="uml:Property" name="receipts" visibility="public" cdec:type="ReceiptFactory" cdec:status="unchanged"/>
        <ownedOperation xmi:type="uml:Operation" name="summarize" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="cart" direction="in" cdec:type="^Cart"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="string"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" name="quick_receipt" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="cart" direction="in" cdec:type="^Cart"/>
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="Receipt"/>
        </ownedOperation>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="class-9762ef082cf9b2f4" name="Cart" cdec:qualifiedName="orders.Cart" cdec:kind="struct" cdec:status="unchanged" cdec:file="orders/cart.odin" cdec:startLine="6" cdec:endLine="9">
