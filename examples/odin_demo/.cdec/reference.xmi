        <ownedAttribute xmi:type="uml:Property" name="owner" visibility="public" cdec:type="string" cdec:status="unchanged"/>
        <ownedOperation xmi:type="uml:Operation" name="cart_total" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="return" direction="return" cdec:type="f64"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" name="add_item" visibility="public" cdec:status="unchanged">
          <ownedParameter xmi:type="uml:Parameter" name="book" direction="in" cdec:type="catalog.Book"/>
        </ownedOperation>
